<Project>
    <PropertyGroup Label="Global Project Properties">
        <TargetFramework>net9.0</TargetFramework>
        <NoWarn>$(NoWarn);NU1507;CS1591;SA1600;SYSLIB0011;CS0436;SA1629;SA1101;SA1309;SA1200;CA1822;CA2007;SA1413;SA1503;SA1500;VSTHRD200;CA1848;SA1012;SA1003;SA1005;SA1137;SA1009;SA1111;SA1201;SA1512;SA1515;CA1062;CA2227;CA1002;CA2201;CA1805;SA1402;SA1501;SA1602;SA1508;SA1124;CA1860;CS8618</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Label="Global Test Project Properties">
    </PropertyGroup>
    <PropertyGroup Label="Global Project Analyzers">
        <EnableNetAnalyzers>true</EnableNetAnalyzers>
        <AnalysisMode>All</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup Label="Global Package References">
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>